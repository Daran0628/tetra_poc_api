<mxfile host="drawio"><diagram name="PoC Front-API 앱 구조" id="poc-app-arch"><mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1260" pageHeight="760" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;PoC Front–API 앱 구조&lt;/b&gt; &lt;font color=&quot;#777777&quot;&gt;(2026-10-06 코드 기준 · Front: tetra-poc-front 088d08a · API: issuance-service)&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1200" height="30" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;테넌트 메인 페이지&lt;/b&gt; (외부)&lt;br&gt;히든폼 GET · JWT(RS256 서명)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;fontColor=#555555;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="290" height="50" as="geometry"/></mxCell><mxCell id="c4" value="Front SPA — React 18 + Vite (BrowserRouter)" style="rounded=1;arcSize=4;dashed=1;dashPattern=8 4;strokeWidth=1.5;strokeColor=#7AA116;fillColor=none;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontColor=#7AA116;html=1;whiteSpace=wrap;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="140" width="290" height="410" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;02 대기방&lt;/b&gt;  /&lt;br&gt;WaitingRoom · 카운트다운 → 지터 후 이동" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF6E4;strokeColor=#7AA116;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="180" width="250" height="52" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;03 번호표&lt;/b&gt;  /queue&lt;br&gt;QueueTicket + useQueuePolling (gap별 1~10초)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF6E4;strokeColor=#7AA116;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="245" width="250" height="52" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;04 쿠폰 발급&lt;/b&gt;  /issue&lt;br&gt;CouponIssuance +